# Copy to .env.local for development. Set the same values in Vercel > Project > Settings > Environment Variables.
# None of these are ever sent to the browser: no NEXT_PUBLIC_ prefix on purpose.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (Phase 2). Password for /admin/login, and a long random string used to sign the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
