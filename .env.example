# Copy to .env.local for development. Set the same values in Vercel > Project > Settings > Environment Variables.
# None of these are ever sent to the browser: no NEXT_PUBLIC_ prefix on purpose.
# With none of the SUPABASE_* values set, the site runs on an in-memory DEMO store with simulated logins (not on Vercel production).

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=             # the "anon" / publishable key: used server-side for customer login
SUPABASE_SERVICE_ROLE_KEY=     # secret: database access and account management, bypasses RLS

# Admin panel (/admin). The password you type at /admin/login, and a long random string (32+ chars) that signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# The public address, for share previews and the sitemap (e.g. https://merch-iitb.shop). On Vercel it falls back to the project's production domain.
SITE_URL=
